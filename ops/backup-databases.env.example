# Copy this to ~/scripts/.backup-env on the server, fill in real values, and
# chmod 600 it. Never commit the real file — this is a template only.
#
# No spaces around the `=` on any line, or bash will misparse it.
set -a
FAMILY_TREE_DB_NAME=forge
FAMILY_TREE_DB_USER=forge
FAMILY_TREE_DB_PASS=

CATACOMBIAN_DB_NAME=forge
CATACOMBIAN_DB_USER=forge
CATACOMBIAN_DB_PASS=

R2_BUCKET=database-backups
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
set +a
